# PC-001 personal config. Copy to .env.copilot only if that file does not exist.
# Fill Keys locally. Never paste credentials into chat or use enterprise keys.
# Match the managed preset in scripts/presentation_copilot.py (2026-10-26).
AI_PROVIDER_FORMAT=openai
TEXT_MODEL_SOURCE=openai
TEXT_MODEL=deepseek-flash
TEXT_API_BASE=https://tokenflux.dev/v1
# Personal Key bound to the DeepSeek group; supports Chat Completions.
TEXT_API_KEY=
IMAGE_MODEL_SOURCE=gemini
IMAGE_MODEL=nano-banana-2
IMAGE_API_BASE=https://tokenflux.dev
# Personal Key bound to Google Image; native GenerateContent. Not /images/generations.
IMAGE_API_KEY=
# No budget authorization is stored in this file. Preview never sends model calls.
# Sources, URLs, model IDs, and limits cannot be changed through the Settings UI in PC-001.

# Include within http {}. Replace placeholders and run nginx -t on the target only.
limit_req_zone $binary_remote_addr zone=pc_rate:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=pc_conn:10m;
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}
server {
    listen 80;
    server_name REPLACE_DOMAIN;
    return 308 https://REPLACE_DOMAIN$request_uri;
}
server {
    listen 443 ssl;
    server_name REPLACE_DOMAIN;
    ssl_certificate REPLACE_CERT_FULLCHAIN;
    ssl_certificate_key REPLACE_CERT_KEY;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    limit_conn pc_conn 12;
    limit_req zone=pc_rate burst=20 nodelay;
    limit_req_status 429;
    limit_conn_status 429;
    add_header X-Content-Type-Options nosniff always;
    # No alias/root to private uploads, runtime state, database, or logs.
    location / {
        proxy_pass http://127.0.0.1:5011;
        proxy_http_version 1.1;
        proxy_set_header Host REPLACE_DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Connection "";
        proxy_buffering off; # SSE status remains visible while a model waits.
        proxy_cache off;     # Includes all authenticated downloads and APIs.
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 780s; # Inactivity timeout, not the model total deadline.
    }
}
